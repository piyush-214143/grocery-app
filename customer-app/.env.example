# Copy to .env and fill in from Firebase Console > Project settings > Your apps > Customer web app config.
# Same Firebase project as owner-app; only FIREBASE_APP_ID_CUSTOMER differs per app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID_CUSTOMER=

# From EAS: `eas project:info` after `eas init`, needed for push notification tokens.
EAS_PROJECT_ID_CUSTOMER=

# Optional: path override if you keep google-services.json outside the default location.
# GOOGLE_SERVICES_JSON_CUSTOMER=./google-services.json
